{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Back & Frontend",
      "configurations": ["Frontend", "Backend"],
      "presentation": {
        "hidden": false,
        "group": "System",
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      "name": "Frontend",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm run dev"
    },
    {
      "name": "Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Backend (Hypercorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "args": ["--hypercorn"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "USE_HYPERCORN": "true"
      },
      "justMyCode": false
    },
    {
      "name": "Backend (with Monitoring)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENABLE_MONITORING": "true"
      },
      "justMyCode": false
    },
    {
      "name": "Update Client",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm run generate-client"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Frontend: Launch Chrome against http://localhost:5173",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
